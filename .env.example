# Optional: Set your Gemini API key for live AI responses (otherwise zero-key MockLLMProvider is used)
GEMINI_API_KEY=

# Flask session signing key (auto-generated fallback used in dev if omitted)
FLASK_SECRET_KEY=careerpilot-dev-secret-change-in-prod

# Optional: Custom SQLite database path (defaults to instance/careerpilot.db)
CAREERPILOT_DB_PATH=
